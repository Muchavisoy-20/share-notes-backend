# ─── Servidor ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Base de datos MySQL ─────────────────────────────────
DB_HOST=localhost / 127.0.0.1
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=sharenotes

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=tu_jwt_secret_super_seguro
JWT_EXPIRES_IN=7d

# ─── Archivos ────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ─── URL pública (para el QR) ────────────────────────────
APP_PUBLIC_URL=http://localhost:3000

# ─── Microservicios ──────────────────────────────────────
MS_PDF_URL=http://localhost:4001
MS_EMAIL_URL=http://localhost:4002
MS_TIMEOUT=10000