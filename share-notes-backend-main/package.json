{
  "name": "sharenotes-backend",
  "version": "1.0.0",
  "description": "Backend para ShareNotes - Plataforma de apuntes universitarios",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --config jest.config.json --forceExit",
    "test:verbose": "jest --config jest.config.json --forceExit --verbose",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "ts-node src/config/migrate.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.8",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.40",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.3",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
